# Venore Docks — variáveis de ambiente. Copie para .env e preencha.
# Obrigatórias: DATABASE_URL e AUTH_SECRET. O resto é opcional (o default está no comentário).

# --- Site -------------------------------------------------------------------------------------
# Endereço público (sitemap, RSS, canonical, Open Graph). Sem ele usa o host da requisição.
# SITE_URL=https://www.exemplo.com
# Erros não tratados do servidor também vão em JSON pra este endpoint (Slack, Discord, etc.)
# ERROR_WEBHOOK_URL=

# --- Banco ---------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/venore
# Banco SEPARADO pros testes de integração (npm run test:integration). Nunca o de desenvolvimento.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/venore_test
# Pool: máx. de conexões (default 5 na Vercel, 10 fora), ociosidade e timeout de conexão (ms).
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_MS=10000
# DATABASE_CONNECT_TIMEOUT_MS=10000
# Tempo máximo de uma query no runtime do Next (ms; 0 desliga). Migrations via script não têm limite.
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Migrations no build (scripts/migrate-on-build.mjs, docs/migrations-guia.md) --------------
# Preview da Vercel NÃO migra por padrão (costuma apontar pro banco de produção).
# MIGRATE_ON_PREVIEW=true
# SKIP_DB_MIGRATIONS=true

# --- Autenticação ------------------------------------------------------------------------------
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
# Primeiro superadmin pela web (/setup). 16+ caracteres; remova depois do setup.
# SETUP_TOKEN=
# Login por senha: ligado automaticamente se não houver OAuth. Torne explícito ou desligue:
# AUTH_ENABLE_CREDENTIALS=true
# AUTH_DISABLE_CREDENTIALS=true
# OAuth (cada provedor aparece no /login quando as variáveis dele estão preenchidas)
# GOOGLE_ID=
# GOOGLE_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
# MICROSOFT_ID=
# MICROSOFT_SECRET=
# MICROSOFT_ISSUER=
# Papel concedido ao cadastro aprovado automaticamente (default: member)
# RBAC_DEFAULT_REGISTRATION_ROLE_KEY=member
# Instalador (npm run db:install:fresh) sem prompt
# INSTALL_ADMIN_EMAIL=
# INSTALL_ADMIN_PASSWORD=

# --- E-mail (recuperação de senha, aviso de cadastro pendente) -------------------------------
# resend | console (só loga, dev) | vazio = desligado ("Esqueci minha senha" some do /login)
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Meu Site <no-reply@exemplo.com>"

# --- Segurança HTTP ---------------------------------------------------------------------------
# CSP: report-only (default) | enforce | off
# CSP_MODE=report-only
# Sites que podem exibir este em iframe (ex: "https://intranet.exemplo.com"). Vazio = nenhum.
# FRAME_ANCESTORS=

# --- Mídia ------------------------------------------------------------------------------------
# vercel-blob | filesystem | local (em memória, só dev/teste)
# MEDIA_STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=
# Blob Store privado (nada acessível pela URL do storage): private
# MEDIA_BLOB_ACCESS=private
# Driver filesystem
# MEDIA_FILESYSTEM_ROOT=./media-storage
# MEDIA_FILESYSTEM_PUBLIC_URL=/api/media/file
# Assinatura das URLs de mídia privada (default: AUTH_SECRET)
# MEDIA_URL_SECRET=

# --- Tarefas agendadas ------------------------------------------------------------------------
# Protege /api/cron/tick (Bearer). Sem ela o endpoint responde 503.
# CRON_SECRET=
# false desliga os timers em processo (serverless com cron externo)
# IN_PROCESS_JOBS=true

# --- Web push ---------------------------------------------------------------------------------
# Gere com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WEB_PUSH_CONTACT=mailto:admin@exemplo.com
# Hosts de push além dos navegadores conhecidos (separados por vírgula)
# WEB_PUSH_EXTRA_HOSTS=

# --- Atualização de tema pelo admin -----------------------------------------------------------
# GITHUB_UPDATES_TOKEN=
# SITE_GITHUB_REPO=dono/repositorio
# SITE_GITHUB_BRANCH=main
