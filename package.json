{
  "name": "venore-docks-1.0.0",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:registries": "tsx scripts/gen-plugin-registry.ts && tsx scripts/gen-theme-registry.ts",
    "postinstall": "npm run gen:registries",
    "predev": "npm run gen:registries",
    "prebuild": "npm run gen:registries && drizzle-kit migrate",
    "prevercel-build": "npm run gen:registries",
    "pretypecheck": "npm run gen:registries",
    "pretest": "npm run gen:registries",
    "pretest:integration": "npm run gen:registries",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:admin-access": "node --env-file=.env scripts/seed-admin-access-permission.mjs",
    "db:seed:media-manage": "node --env-file=.env scripts/seed-media-manage-permission.mjs",
    "db:seed:cms-menus-manage": "node --env-file=.env scripts/seed-cms-menus-permission.mjs",
    "db:seed:observability-logs-view": "node --env-file=.env scripts/seed-observability-logs-permission.mjs",
    "db:seed:observability-logs-clear": "node --env-file=.env scripts/seed-observability-logs-clear-permission.mjs",
    "db:seed:observability-audit-view": "node --env-file=.env scripts/seed-observability-audit-view-permission.mjs",
    "db:install:fresh": "tsx --env-file=.env scripts/install-fresh.ts",
    "db:bootstrap-superadmin": "tsx --env-file=.env scripts/bootstrap-superadmin.ts",
    "db:seed:aprenda-musica": "tsx --env-file=.env scripts/seed-aprenda-musica.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/static-renderer": "^3.29.2",
    "@venore/plugin-broadcast": "git+https://github.com/venore-docks/venore-plugin-broadcast.git#v1.8.0",
    "@venore/theme-fearless": "git+https://github.com/venore-docks/venore-theme-fearless.git#v1.0.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "jsdom": "26.1.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-boundaries": "^7.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
