{
  "name": "venore-docks-1.0.0",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:registries": "tsx scripts/gen-plugin-registry.ts && tsx scripts/gen-theme-registry.ts",
    "postinstall": "npm run gen:registries",
    "predev": "npm run gen:registries",
    "gen:registries:strict": "tsx scripts/gen-plugin-registry.ts && tsx scripts/gen-theme-registry.ts --strict",
    "prebuild": "npm run gen:registries:strict && node scripts/migrate-on-build.mjs",
    "prevercel-build": "npm run gen:registries",
    "pretypecheck": "npm run gen:registries",
    "pretest": "npm run gen:registries",
    "pretest:integration": "npm run gen:registries",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:plugins": "vitest run --config vitest.plugins.config.ts",
    "test:e2e": "playwright test",
    "theme:check": "tsx scripts/theme-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:plugins": "tsx --env-file-if-exists=.env scripts/migrate-installed-plugins.ts",
    "db:install:fresh": "tsx --env-file=.env scripts/install-fresh.ts",
    "db:update": "tsx --env-file=.env scripts/update-instance.ts",
    "db:bootstrap-superadmin": "tsx --env-file=.env scripts/bootstrap-superadmin.ts",
    "db:apply-plugin-migrations": "tsx --env-file=.env scripts/apply-plugin-migrations.ts"
  },
