# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# media (driver local de contexts/media, dev)
/public/uploads/

# MEDIA_STORAGE_DRIVER=filesystem — mídia gravada no disco do servidor self-hosted, específica
# de cada instância. Default de MEDIA_FILESYSTEM_ROOT.
/media-storage/

# Gerados por scripts/gen-plugin-registry.ts a partir das deps @venore/plugin-* do package.json
# (postinstall/predev/prebuild). Ver docs/plugins-repos-separados-plano.md.
/src/plugins/registry.generated.ts
/src/plugins/route-registry.generated.ts
/src/plugins/contributions.generated.ts
/src/plugins/contributions.client.generated.ts
/src/plugins/plugin-keys.generated.ts
/src/plugins/plugin-barrels.generated.ts
/src/plugins/plugin-sources.generated.css

# Gerados por scripts/gen-theme-registry.ts a partir das deps @venore/theme-* do package.json.
/src/themes/registry.generated.ts
/src/themes/theme-imports.generated.css

# Cada plugin é um PACOTE npm (@venore/plugin-<key>) — instala em node_modules, nunca em
# src/plugins/. Só os fixtures _fixture-cross-* do teste de boundary continuam versionados lá.

# broadcast plugin — vídeos são específicos de cada deploy/servidor, nunca devem ir pro Git
# (arquivos grandes). .gitkeep preserva a pasta vazia num clone novo.
/public/broadcast/videos/*
!/public/broadcast/videos/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# academy — artefatos gerados por scripts/build-course-bundle.ts (a fonte é o .md).
# O .zip é versionado (dá pra importar direto num clone/outra máquina); o manifest.json não.
/docs/cursos/dist/*
!/docs/cursos/dist/*.zip

# Backup local dos plugins antigos durante a migração pra repos separados — nunca versionar.
/backup/
